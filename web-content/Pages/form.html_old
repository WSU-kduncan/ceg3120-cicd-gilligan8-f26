<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, inital-scale=" 1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="../style.css" />
   

</head>

<body>
    <header>
        <h1>The Wright State CS2800 Library</h1>
        <h3>The best source for all your HTML needs</h3>
    </header>
    <nav class="navbar">
    <ul>
          <li><a href="../index.html">Home</a></li>
          <li><a href="description.html">Description</a></li>
          <li><a href="#" class="active">Form</a></li>
    </ul>
    </nav>
    <section>
    <form action="" method="" name="contactform">
        <table>
            <tr>
                <td class="tdcenter"><label for="first_name">First Name</label></td>
                <td><input type="text" name="first_name" id="first_name"></label></td>
            </tr>
            <tr>
                <td><label for="last_name">Last Name</label></td>
                <td><input type="text" name="last_name" id="last_name"></label>
            </tr>
            <tr>
                <td><label for="password">Password</label></td>
                <td><input type="password" name="password" id="password"></td>
            </tr>
            <tr>
                <td><label for="user_email">Email</label></td>
                <td><input type="email" name="user_email" id="email"></label></td>
            </tr>
            <tr>
                <td><label for="salary">Salary</label></td>
                <td><input type="number" name="salary" id="salary"></label></td>
            </tr>
            
            <tr>
                <td><label for="language">Choose your Favorite Language</label>></label></td>
                <td>
                    <input type="radio" name="language" id="" value="Python"><label for="">Python</label>
                    <input type="radio" name="language" id="" value="JavaScript"><label for="">JavaScript</label>
                    <input type="radio" name="language" id="" value="Java"><label for="">Java</label>
                    <input type="radio" name="language" id="" value="C"><label for="">C</label>
                </td>
            </tr>
            <tr>
                <td><label for="Experience"></label></td>\
                <td>
                    <select name="Experience" id="">
                        <option value="less than 1 year">Less Than 1 Year</option>
                        <option value="1-2 years" selected>1-2 Years</option>
                        <option value="3+ years">3+ Years</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>
                    <lable for="Transportation">What kind of Transportation do you have?</lable>
                </td>
                <td><input type="checkbox" name="Transportation" value="Bike"> 
                <label for="bike"> Bike</label> 
                <input type="checkbox" name="Transportation" value="Car"> 
                <label for="Car">Car</label> 
                <input type="checkbox" name="Transportation" value="Bus"> 
                <label for="Bus">Bus</label> 
                <input type="checkbox" name="Transportation" value="Carpool"> 
                <label for="Carpool">Carpool</label> 
                <input type="checkbox" name="Transportation" value="Plane"> 
                <label for="Plane">Plane</label> 
                    </td>

            </tr>
            <tr>
                <td><label for="user_expectation">Enter Why you want this job</label></td>
                <td><textarea name="user_expectation" id="" cols="30" rows="10"></textarea></td>
            </tr>
            <tr>
                <td></td>
                <td>
                    <input id="submitBtn" type="submit" value="Sent IT" onclick="getFormData(); event.preventDefault();">
                    <input type="reset" value="Clear">
                    <input type="button" value="Calculate">
                </td>
            </tr>

        </table>
    </form>
    </section>
    <section>
        <p>Form Output -----   </p>
        <p style="color: black;"><span id="output"></span></p>

    </section>
    <footer>
            <h6>&copy; Nicholas Gilligan 2026</h6>
    </footer>

    

 <script src="../script.js"></script>

</body>






</html>